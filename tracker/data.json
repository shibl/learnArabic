  "decisions": [
    {
      "date": "2026-11-05",
      "title": "Track everything in a JSON file in the repo",
      "why": "Every update is a git commit, so the history is auditable and the dashboard is just a static page on GitHub Pages — no server to run."
    },
    {
      "date": "2026-11-05",
      "title": "Target ages 4–10 heritage learners, not adult learners",
      "why": "They already hear Arabic at home; reading + linking dialect to standard Arabic is the unmet need."
    },
    {
      "date": "2026-11-05",
      "title": "Interface in English & French, content in Arabic",
      "why": "Kids are schooled in the local language; France and Canada are large early markets."
    },
    {
      "date": "2026-11-05",
      "title": "Web app (PWA) first, app stores later",
      "why": "Ships fastest, no store fees, works offline, one codebase; wrap for stores in Q2 2027."
    },
    {
      "date": "2026-11-05",
      "title": "Weekend schools are a channel, not a competitor",
      "why": "They gather motivated families and need homework between classes."
    },
    {
      "date": "2026-11-05",
      "title": "Teach standard spelling, show the home word beside it",
      "why": "Kids read standard Arabic in books but hear dialect at home; showing both says 'both are Arabic' instead of 'you're wrong'."
    }
  ],
  "needsYou": [
    {
      "title": "Turn on GitHub Pages (1 minute)",
      "detail": "My access can't change repo settings. In GitHub: Settings → Pages → Source: Deploy from a branch → main / (root) → Save. Then https://shibl.github.io/learnArabic/ goes live. Until then the tracker works at raw.githack.com."
    },
    {
      "title": "Pick a brand name",
      "detail": "'Huroof' is used by many small apps. I'll propose 3 distinctive names with domain availability; you choose."
    },
    {
      "title": "Native-speaker voice for audio",
      "detail": "Recorded audio is the biggest quality lever. Do you (or someone you trust) want to record ~200 short clips? I'll prepare the script and a simple recording page."
    }
  ],
